{
  "name": "hxaxd-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node src/app/install.mjs",
    "translation:setup": "node src/app/translation/setup.mjs",
    "ocr:setup": "node src/app/ocr/setup.mjs",
    "tex:setup": "node src/app/latex/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 8642",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8642",
    "typecheck": "next typegen && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "predev": "node src/app/files/copy-pdf-assets.mjs",
    "prebuild": "node src/app/files/copy-pdf-assets.mjs",
    "test:coverage": "vitest run --coverage",
    "analyze": "knip"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "busboy": "^1.6.0",
    "jose": "6.2.12",
    "katex": "0.19.0",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "server-only": "^0.0.1",
    "strip-json-comments": "5.0.3",
    "typebox": "1.3.27",
    "use-intl": "^4.14.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "knip": "^6.43.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.3",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.0.3"
  },
  "knip": {
    "entry": [
      "src/app/models/invoke.mjs"
    ],
    "ignoreBinaries": [
      "uv",
      "wsl.exe"
    ]
  }
}
